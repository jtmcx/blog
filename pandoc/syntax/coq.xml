    <contexts>
      <context name="Normal" attribute="Normal Text" lineEndContext="#stay">
        <StringDetect String="(*" attribute="Comment" context="Comment" beginRegion="Comment"/>
        <DetectChar char="&quot;" attribute="String" context="String"/>
        <keyword String="vernacular" attribute="Vernacular" context="#stay"/>
        <keyword String="keywords" attribute="Keyword" context="#stay"/>
        <keyword String="tactics" attribute="Tactic" context="#stay"/>
        <keyword String="types" attribute="DataType" context="#stay"/>
        <Float attribute="Number" context="#stay"/>
        <Int attribute="Number" context="#stay"/>
        <StringDetect String="&lt;-&gt;" attribute="Operator" context="#stay"/>
        <StringDetect String="-&gt;" attribute="Operator" context="#stay"/>
        <StringDetect String="=&gt;" attribute="Operator" context="#stay"/>
        <StringDetect String=":=" attribute="Operator" context="#stay"/>
        <StringDetect String="/\" attribute="Operator" context="#stay"/>
        <StringDetect String="\/" attribute="Operator" context="#stay"/>
        <StringDetect String="|-" attribute="Operator" context="#stay"/>
        <StringDetect String="::" attribute="Operator" context="#stay"/>
        <StringDetect String="==" attribute="Operator" context="#stay"/>
        <StringDetect String="&lt;&gt;" attribute="Operator" context="#stay"/>
        <StringDetect String="&lt;=" attribute="Operator" context="#stay"/>
        <StringDetect String="&gt;=" attribute="Operator" context="#stay"/>
        <DetectChar char="~" attribute="Operator" context="#stay"/>
        <RegExpr String="[A-Za-z_][A-Za-z0-9_']*" attribute="Normal Text" context="#stay"/>
        <AnyChar String="+-*/=&lt;&gt;@%^|:;,.()[]{}!?&amp;" attribute="Symbol" context="#stay"/>
      </context>
      <context name="Comment" attribute="Comment" lineEndContext="#stay">
        <StringDetect String="(*" attribute="Comment" context="Comment" beginRegion="Comment"/>
        <StringDetect String="*)" attribute="Comment" context="#pop" endRegion="Comment"/>
      </context>
      <context name="String" attribute="String" lineEndContext="#stay">
        <Detect2Chars char="&quot;" char1="&quot;" attribute="String" context="#stay"/>
        <DetectChar char="&quot;" attribute="String" context="#pop"/>
      </context>
    </contexts>
